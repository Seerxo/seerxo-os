# Company OS configuration. Copy to .env, fill in, chmod 600.
# .env is gitignored (§10). Never commit real values.

# ---------------------------------------------------------------- database
POSTGRES_DB=company
POSTGRES_USER=company
POSTGRES_PASSWORD=                 # generate: openssl rand -base64 32
DATABASE_URL=                      # set automatically by docker-compose

# ---------------------------------------------------------------- notifications (§111)
# Reuses the existing Seerxo Telegram bot. Empty values disable delivery;
# events are still recorded, so nothing is lost silently.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=           # comma separated
ALERT_DEDUPE_HOURS=6

# ---------------------------------------------------------------- environment
ENVIRONMENT=production

# ---------------------------------------------------------------- Founder Desk edge access
# Remote-managed Cloudflare Tunnel token. Keep the real value only in the protected
# server .env; the Desk and the API are reached only through Cloudflare Access, never a public port.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------- Cloudflare R2 backup
# Bucket and token are created by the founder. Until these are set, scripts/backup.sh
# runs in LOCAL_ONLY mode: it still dumps, checksums and verifies integrity locally,
# and reports BACKUP_FAILED for the missing off-site leg rather than passing silently.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=company-backups
R2_ENDPOINT=                       # https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PREFIX=my-host

# Local retention (§156): number of backup stamps to keep per class and target.
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12
BACKUP_LOCAL_DIR=/opt/company-os/backups
BACKUP_RESTORE_TEST_EVERY_DAYS=7
# age public key (age1...). coolify-db and config are uploaded encrypted to it; the private
# key stays off this host (password manager). Empty in production = those two targets FAIL
# (local copy kept, not uploaded); elsewhere = uploaded unencrypted with a WARN.
BACKUP_AGE_RECIPIENT=

# Company OS API base, used by host-level scripts.
COMPANY_API=http://company-api:8000

# ---------------------------------------------------------------- Unattended worker
# Claude subscription token from `claude setup-token` on the founder's machine. This is
# existing access. NEVER put ANTHROPIC_API_KEY / OPENAI_API_KEY here: the worker treats
# them as metered spend, refuses to run, and opens a SEV1 incident.
CLAUDE_CODE_OAUTH_TOKEN=
WORKER_CLAUDE_MODEL=sonnet
# Explicit fresh-evidence waits only. Keep OFF until the founder-approved pilot.
ENABLE_AUTOMATIC_EXTERNAL_RELEASE=false

# ---------------------------------------------------------------- API caller scopes
# app/api_auth.py. Each token: >= 32 random chars (e.g. `openssl rand -hex 32`), one per
# caller, never shared. YOUTUBE also goes into youtube-auto's env (COMPANY_OS_TOKEN); DESK has no
# caller since the Vercel proxy was retired (2026-10-06) and is kept until reviewed. Host scripts using `docker exec company-api curl localhost` need none.
# enforce is the default; `log` only while verifying a rollout (WOULD_DENY lines).
API_AUTH_MODE=enforce
# Source address of host callers on the published port (SSH-tunnel Desk), as logged by
# `api-auth WOULD_DENY ... ip=`. Empty trusts no gateway.
API_HOST_IPS=
COMPANY_API_TOKEN_ADMIN=
COMPANY_API_TOKEN_DESK=
COMPANY_API_TOKEN_YOUTUBE=

# Direct Founder Desk via Cloudflare Access + Tunnel (API only). Configure together
# at founder-approved cutover; never route the connector through a trusted host IP.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_DESK_AUD=
CF_ACCESS_DESK_EMAILS=
CF_ACCESS_DESK_HOST=

# ---------------------------------------------------------------- business reconciler
# Goal planning tasks run unattended (CEO, no side effects; proposals land as BACKLOG).
# Founder decision 2026-10-06. false pauses it without a deploy-time code change.
RECONCILER_AUTONOMOUS_PLANNING=true
# Read-only research/analysis proposals from approved runs start on their own (worker).
PROPOSAL_AUTO_READY=true

# Seerxo funnel pull: >= 32 random chars, also set as COMPANY_OS_FUNNEL_TOKEN in Seerxo's backend env.
SEERXO_FUNNEL_TOKEN=
SEERXO_FUNNEL_URL=
